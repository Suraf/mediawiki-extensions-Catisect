{
	"name": "Category Intersection",
	"version": "1.0.1",
	"author": "foxlit",
	"descriptionmsg": "catisect-description",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"MessagesDirs": {
		"Catisect": [
			"i18n"
		]
	},
	"namespaces": [
		{
			"id": 600,
			"constant": "NS_INTERSECTION",
			"name": "Intersection"
		},
		{
			"id": 601,
			"constant": "NS_INTERSECTION_TALK",
			"name": "Intersection_talk"
		}
	],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\Catisect\\": "src/"
	},
	"config": {
		"CatisectMaxCategories": {
			"value": 10,
			"description": "Maximum number of distinct categories a single intersection may combine."
		}
	},
	"Hooks": {
		"ArticleFromTitle": "MediaWiki\\Extension\\Catisect\\CatisectHooks::onArticleFromTitle",
		"TitleIsAlwaysKnown": "MediaWiki\\Extension\\Catisect\\CatisectHooks::onTitleIsAlwaysKnown",
		"SkinTemplateNavigation::Universal": "MediaWiki\\Extension\\Catisect\\CatisectHooks::onSkinTemplateNavigationUniversal",
		"userCan": "MediaWiki\\Extension\\Catisect\\CatisectHooks::onUserCan",
		"ParserBeforeInternalParse": "MediaWiki\\Extension\\Catisect\\CatisectHooks::onParserBeforeInternalParse"
	},
	"manifest_version": 2
}
